:root {
    --background: #071426;
    --panel: #10243b;
    --cyan: #4de2e8;
    --blue: #5b8cff;
    --text: #eef6ff;
    --muted: #9eb3cc;
    --border: #294763;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background:
        radial-gradient(
            circle at top left,
            #15365b,
            transparent 40%
        ),
        var(--background);
    color: var(--text);
}

.header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 22px 5%;
    border-bottom: 1px solid var(--border);
}

.logo {
    width: 55px;
    height: 55px;
    display: grid;
    place-items: center;
    border-radius: 17px;
    font-size: 30px;
    font-weight: 900;
    color: #071426;
    background: linear-gradient(
        135deg,
        var(--cyan),
        var(--blue)
    );
    box-shadow: 0 8px 25px #4de2e844;
}

.brand h2 {
    margin: 0;
    font-size: 21px;
}

.brand h2 span {
    color: var(--cyan);
}

.brand p {
    margin: 5px 0 0;
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--muted);
}

.container {
    width: 92%;
    max-width: 1100px;
    margin: auto;
}

.hero {
    padding: 45px 0 30px;
}

.eyebrow {
    color: var(--cyan);
    font-weight: bold;
    letter-spacing: 2px;
}

.hero h1 {
    font-size: clamp(34px, 7vw, 60px);
    line-height: 1.1;
}

.hero h1 span {
    display: block;
    color: var(--cyan);
}

.hero-description {
    max-width: 600px;
    color: var(--muted);
    line-height: 1.8;
}

.panel {
    margin: 20px 0;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: linear-gradient(
        145deg,
        #10243b,
        #091729
    );
    box-shadow: 0 15px 35px #0004;
}

.panel h2 {
    margin-top: 0;
}

.panel p {
    color: var(--muted);
    line-height: 1.6;
}

input[type="file"] {
    width: 100%;
    margin: 15px 0;
    padding: 12px;
    border: 1px dashed var(--cyan);
    border-radius: 12px;
    color: var(--text);
}

button {
    padding: 13px 18px;
    border: 0;
    border-radius: 12px;
    background: linear-gradient(
        110deg,
        #087f9e,
        #2866d7
    );
    color: white;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    transform: translateY(-2px);
}

#imagePreview {
    margin-top: 18px;
    min-height: 100px;
    padding: 12px;
    border-radius: 14px;
    background: #06111f;
    text-align: center;
}

#imagePreview img {
    max-width: 100%;
    max-height: 400px;
    border-radius: 10px;
}

#map {
    width: 100%;
    height: 350px;
    border-radius: 15px;
    background: #0a192a;
}

#imageInfo p {
    padding: 10px;
    border-bottom: 1px solid var(--border);
    overflow-wrap: anywhere;
}

#googleMapsLink {
    display: inline-block;
    margin-top: 12px;
    color: var(--cyan);
}

footer {
    margin-top: 35px;
    padding: 25px 5%;
    border-top: 1px solid var(--border);
    text-align: center;
    color: var(--muted);
    font-size: 13px;
}

@media (max-width: 600px) {
    .panel {
        padding: 16px;
    }

    .hero {
        padding-top: 25px;
    }

    #map {
        height: 300px;
    }
}
